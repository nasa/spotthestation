{
  "name": "spot-the-station-app",
  "version": "1.7.0",
  "private": true,
  "scripts": {
    "start": "react-native start",
    "ios": "react-native run-ios",
    "android": "react-native run-android --active-arch-only",
    "compile": "tsc --noEmit -p . --pretty",
    "format": "prettier --write \"app/**/*.{js,jsx,json,md,ts,tsx}\"",
    "lint": "eslint index.js App.js app test --fix --ext .js,.ts,.tsx && npm run format",
    "patch": "patch-package",
    "test": "TZ=UTC jest -c jest.unit.config.js --runInBand",
    "test:watch": "jest -c jest.unit.config.js --watch",
    "test:e2e": "TZ=UTC jest -c jest.e2e.config.js --runInBand",
    "adb": "adb reverse tcp:9090 tcp:9090 && adb reverse tcp:3000 tcp:3000 && adb reverse tcp:9001 tcp:9001 && adb reverse tcp:8081 tcp:8081",
    "postinstall": "node ./bin/postInstall",
    "bundle:ios": "react-native bundle --entry-file index.js --platform ios --dev false --bundle-output ios/main.jsbundle --assets-dest ios",
    "bundle:android": "react-native bundle --platform android --dev false --entry-file index.js --bundle-output android/app/src/main/assets/index.android.bundle --assets-dest android/app/src/main/res",
    "release:ios": "echo 'Not implemented yet: release:ios. Use Xcode. More info: https://reactnative.dev/docs/next/publishing-to-app-store'",
    "release:android": "cd android && rm -rf app/src/main/res/drawable-* && ./gradlew assembleRelease && cd - && echo 'APK generated in ./android/app/build/outputs/apk/release/app-release.apk'",
    "clean": "npx react-native-clean-project",
    "clean-all": "npx react-native clean-project-auto",
    "expo:start": "expo start",
    "expo:android": "expo start --android",
    "expo:ios": "expo start --ios",
    "expo:web": "expo start --web",
    "update-minor": "npm --no-git-tag-version version minor && npm run update-build",
    "update-patch": "npm --no-git-tag-version version patch && npm run update-build",
    "update-build": "sed -i '' \"s/Target\\\\\\\\\\\\\\ Support\\\\\\\\\\\\\\ Files/Target' 'Support' 'Files/g\" ios/STSApp.xcodeproj/project.pbxproj && react-native-version -A -s $(date +'%Y%m%d%H')"
  },
  "overrides": {
    "react-error-overlay": "6.0.9"
  },
  "dependencies": {
    "@expo-google-fonts/space-grotesk": "^0.3.0",
    "@expo/webpack-config": "^0.17.2",
    "@formatjs/intl-datetimeformat": "^6.18.0",
    "@formatjs/intl-getcanonicallocales": "^2.5.5",
    "@formatjs/intl-locale": "^4.2.11",
    "@formatjs/intl-numberformat": "^8.15.4",
    "@formatjs/intl-pluralrules": "^5.4.4",
    "@notifee/react-native": "^9.1.8",
    "@react-native-async-storage/async-storage": "^2.0.0",
    "@react-native-camera-roll/camera-roll": "^7.10.0",
    "@react-native-community/datetimepicker": "^8.0.0",
    "@react-native-firebase/analytics": "^21.14.0",
    "@react-native-firebase/app": "^21.14.0",
    "@react-navigation/bottom-tabs": "^6.3.2",
    "@react-navigation/native": "^6.0.8",
    "@react-navigation/native-stack": "^6.0.2",
    "@react-navigation/stack": "^6.3.21",
    "@rnmapbox/maps": "^10.2.2",
    "@sentry/react-native": "^6.10.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/react-native": "^13.2.0",
    "@types/rn-fetch-blob": "^1.2.3",
    "@types/suncalc": "^1.9.2",
    "@types/uuid": "^10.0.0",
    "apisauce": "^3.2.0",
    "d3-shape": "^3.2.0",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.0",
    "expo": "^53.0.13",
    "expo-application": "^6.1.4",
    "expo-blur": "^14.1.5",
    "expo-calendar": "~14.1.4",
    "expo-constants": "^17.1.6",
    "expo-device": "^7.1.4",
    "expo-file-system": "^18.1.10",
    "expo-font": "^13.3.1",
    "expo-gl": "^15.1.7",
    "expo-linking": "^7.1.5",
    "expo-localization": "^16.1.5",
    "expo-modules-core": "^2.4.1",
    "expo-status-bar": "^2.2.3",
    "expo-store-review": "~8.1.5",
    "expo-three": "^8.0.0",
    "fast-xml-parser": "^5.2.0",
    "geomagnetism": "^0.2.0",
    "htmlparser2": "^10.0.0",
    "i18n-js": "^3.9.2",
    "mitt": "^3.0.1",
    "mobx": "6.6.0",
    "mobx-react-lite": "3.4.0",
    "mobx-state-tree": "5.1.5",
    "moment-timezone": "^0.6.0",
    "qs": "^6.14.0",
    "react": "19.0.0",
    "react-native": "^0.79.0",
    "react-native-bootsplash": "^6.3.9",
    "react-native-code-push": "^9.0.1",
    "react-native-config": "^1.5.5",
    "react-native-device-info": "^14.0.4",
    "react-native-element-dropdown": "^2.12.4",
    "react-native-geolocation-service": "^5.3.1",
    "react-native-gesture-handler": "^2.26.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-modal": "^13.0.0",
    "react-native-modal-datetime-picker": "^18.0.0",
    "react-native-orientation-locker": "^1.7.0",
    "react-native-permissions": "^5.3.0",
    "react-native-reanimated": "^3.17.5",
    "react-native-record-screen": "^0.6.2",
    "react-native-safe-area-context": "^5.4.0",
    "react-native-screens": "^4.10.0",
    "react-native-sensors": "^7.3.6",
    "react-native-share": "^12.0.9",
    "react-native-snackbar": "^2.9.0",
    "react-native-svg": "^15.11.2",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-version": "^4.0.0",
    "react-native-version-check": "^3.4.7",
    "react-native-view-shot": "^4.0.3",
    "react-native-vision-camera": "^4.7.2",
    "react-native-web": "~0.18.7",
    "react-native-webview": "^13.14.1",
    "react-native-youtube-iframe": "^2.3.0",
    "suncalc": "^1.9.0",
    "three": "^0.147.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@babel/plugin-proposal-decorators": "7.18.2",
    "@babel/plugin-proposal-optional-catch-binding": "7.16.7",
    "@babel/plugin-transform-export-namespace-from": "^7.27.1",
    "@babel/preset-env": "^7.25.3",
    "@babel/runtime": "^7.25.0",
    "@react-native-community/cli": "^18.0.0",
    "@react-native-community/cli-platform-android": "^18.0.0",
    "@react-native-community/cli-platform-ios": "^18.0.0",
    "@react-native/babel-preset": "^0.79.0",
    "@react-native/metro-config": "^0.79.0",
    "@types/d3-shape": "^3.1.1",
    "@types/i18n-js": "^3.8.9",
    "@types/jest": "29.5.14",
    "@types/lodash": "^4.14.192",
    "@types/lodash.throttle": "^4.1.7",
    "@types/qs": "^6.9.18",
    "@types/react": "18.2.14",
    "@types/react-native": "0.70.10",
    "@types/react-native-version-check": "^3.4.8",
    "@types/react-test-renderer": "^18.0.5",
    "@types/three": "^0.146.0",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "babel-jest": "^29.6.3",
    "babel-loader": "8.2.5",
    "eslint": "^8.19.0",
    "eslint-config-prettier": "8.5.0",
    "eslint-config-standard": "17.0.0",
    "eslint-plugin-import": "2.26.0",
    "eslint-plugin-n": "^15.0.0",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-promise": "6.0.0",
    "eslint-plugin-react": "7.30.0",
    "eslint-plugin-react-native": "4.0.0",
    "expo-modules-autolinking": "^2.0.8",
    "fbjs-scripts": "3.0.1",
    "jest": "^29.2.1",
    "jest-circus": "29",
    "jest-environment-node": "29",
    "jest-expo": "^53.0.9",
    "metro-source-map": "0.72.3",
    "mocha": "6",
    "mockdate": "^3.0.5",
    "patch-package": "^8.0.0",
    "postinstall-prepare": "1.0.1",
    "prettier": "2.8.8",
    "react-devtools-core": "4.24.7",
    "react-dom": "^19.0.0",
    "react-native-dotenv": "^3.4.6",
    "reactotron-core-client": "^2.8.10",
    "ts-jest": "^29.4.0",
    "typescript": "5.4.5",
    "webpack": "4",
    "webpack-dev-server": "^3"
  },
  "resolutions": {
    "@expo/dev-server": "0.1.120"
  },
  "engines": {
    "node": ">=18"
  },
  "prettier": {
    "printWidth": 100,
    "semi": false,
    "singleQuote": false,
    "trailingComma": "all"
  },
  "eslintConfig": {
    "root": true,
    "parser": "@typescript-eslint/parser",
    "extends": [
      "plugin:@typescript-eslint/recommended",
      "plugin:@typescript-eslint/recommended-requiring-type-checking",
      "plugin:react/recommended",
      "plugin:react-native/all",
      "standard",
      "prettier"
    ],
    "plugins": [
      "@typescript-eslint",
      "react",
      "react-native"
    ],
    "parserOptions": {
      "ecmaFeatures": {
        "jsx": true
      },
      "project": "./tsconfig.json"
    },
    "settings": {
      "react": {
        "pragma": "React",
        "version": "detect"
      }
    },
    "globals": {
      "__DEV__": false,
      "jasmine": false,
      "beforeAll": false,
      "afterAll": false,
      "beforeEach": false,
      "afterEach": false,
      "test": false,
      "expect": false,
      "describe": false,
      "jest": false,
      "it": false
    },
    "rules": {
      "@typescript-eslint/ban-ts-ignore": 0,
      "@typescript-eslint/ban-ts-comment": 0,
      "@typescript-eslint/explicit-function-return-type": 0,
      "@typescript-eslint/explicit-member-accessibility": 0,
      "@typescript-eslint/explicit-module-boundary-types": 0,
      "@typescript-eslint/indent": 0,
      "@typescript-eslint/member-delimiter-style": 0,
      "@typescript-eslint/no-empty-interface": 0,
      "@typescript-eslint/no-explicit-any": 0,
      "@typescript-eslint/no-object-literal-type-assertion": 0,
      "@typescript-eslint/no-var-requires": 0,
      "@typescript-eslint/no-unsafe-assignment": 0,
      "@typescript-eslint/no-unsafe-member-access": 0,
      "@typescript-eslint/no-misused-promises": 0,
      "@typescript-eslint/unbound-method": 0,
      "@typescript-eslint/no-unused-vars": [
        "error",
        {
          "argsIgnorePattern": "^_",
          "varsIgnorePattern": "^_"
        }
      ],
      "semi": "error",
      "comma-dangle": 0,
      "multiline-ternary": 0,
      "n/no-callback-literal": 0,
      "no-undef": 0,
      "no-unused-vars": 0,
      "no-use-before-define": 0,
      "no-global-assign": 0,
      "quotes": 0,
      "react-native/no-raw-text": 0,
      "react-native/split-platform-components": 0,
      "react/no-unescaped-entities": 0,
      "react/prop-types": 0,
      "space-before-function-paren": 0
    }
  }
}
